{
  "manifest_version": 3,
  "name": "CitoSkeleton",
  "version": "0.68.1",
  "description": "See what ChatGPT, Gemini, Perplexity and Grok search, fetch and cite \u2014 and which brands they name. Local-only, no account.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "alarms",
    "notifications",
    "languageModel",
    "cookies",
    "offscreen",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://grok.com/*",
    "https://x.com/*"
  ],
  "incognito": "spanning",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/content-iso.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "CitoSkeleton",
    "default_popup": "ui/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
